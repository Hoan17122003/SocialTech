{
    "Application": {
        "Name": "SocialBackEnd",
        "Version": "v1",
        "PublicBaseUrl": "https://public-url-whenIdeploy"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Smtp": {
        "Host": "smtp.gmail.com",
        "Port": 465,
        "UseSsl": true,
        "FromEmail": "",
        "FromName": "SocialTech",
        "OAuth2": {
            "TokenEndpoint": "https://oauth2.googleapis.com/token",
            "ClientId": "",
            "ClientSecret": "",
            "RefreshToken": "",
            "Scope": "https://mail.google.com/"
        }
    },
    "ConnectionStrings": {
        "DefaultConnection": "Server=127.0.0.1;Port=3306;Database=SocialTechDatabase;User=root;Password=SocialTechPass@2026;SslMode=Disabled;AllowPublicKeyRetrieval=True;"
    },
    "Paganation": {},
    "jwt": {
        "Issuer": "SocialTech",
        "Audience": "SocialTech.Web",
        "SecretKey": "SocialTechJwtSecretKeyForHs256MustBeAtLeast32BytesLong2026",
        "AccessTokenMinutes": 120,
        "RefreshTokenMinutes": 1440
    },
    "RedisCacheSettings": {
        "Configuration": "localhost:6379"
    },
    "Kafka": {
        "BootstrapServers": "localhost:9094",
